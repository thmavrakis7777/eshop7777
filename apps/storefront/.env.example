# Copy to .env.local and fill in.
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Medusa Admin -> Settings -> Publishable API Keys -> "Default Publishable API Key".
# This is meant to be public/client-exposed (like a Stripe publishable key) —
# it is not a secret, unlike the backend's DATABASE_URL/JWT_SECRET.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
