# Copy to .env.local and fill in.

# Supabase Postgres connection string (Session pooler recommended). Required —
# every catalog/cart/checkout/admin read and write goes through this.
DATABASE_URL=

# Optional. The site's own real public URL — backs canonical URLs, sitemap
# entries, JSON-LD, Open Graph tags, and the link inside password-reset
# emails (lib/site-config.ts, lib/email/send.ts). Vercel auto-provides
# VERCEL_URL for every deployment, but that's the deployment's own hash URL
# (e.g. project-xyz123.vercel.app), NOT a custom domain attached in the
# Vercel dashboard — so once a real domain is attached, set this explicitly
# to it (e.g. https://www.mavrakishome.gr) or canonical URLs and reset-
# password links will point at the wrong host. Required for a correct
# password-reset link in production if a custom domain is in use.
NEXT_PUBLIC_SITE_URL=

# Resend (transactional email — order confirmation, shipment notification,
# password reset). RESEND_API_KEY and RESEND_FROM_EMAIL are required
# together; if either is unset, lib/email/send-core.ts logs
# EMAIL_CONFIG_MISSING and skips sending rather than blocking checkout,
# shipment saves, or password reset — so the app runs fine without these in
# development, but production needs both for customers to actually receive
# email.
#
# RESEND_API_KEY: Resend dashboard -> API Keys -> Create API Key. "Sending
# access" is enough (no domain/DNS management needed by this key) — this key
# is server-only (never sent to the browser) and calls Resend's REST API
# directly (no SDK). Never commit a real value here or anywhere else.
RESEND_API_KEY=

# RESEND_FROM_EMAIL: the "from" address customers see, e.g.
# no-reply@mavrakishome.gr. Must be on a domain verified in Resend ->
# Domains (adds the DNS records Resend gives you: SPF/DKIM, typically a TXT
# and a couple of CNAME/MX records depending on the DNS host) — Resend
# rejects sends from an unverified domain.
RESEND_FROM_EMAIL=

# Optional. If set, customer replies to a transactional email go here
# instead of RESEND_FROM_EMAIL (which is typically a no-reply address).
RESEND_REPLY_TO_EMAIL=

# Supabase project URL and service role key — public URL derivation
# (lib/storage/urls.ts) only needs NEXT_PUBLIC_SUPABASE_URL; image upload
# itself isn't built yet (blocked on these credentials), gated by
# isStorageConfigured() in lib/admin/cms.ts, which needs both. Until both are
# set, the admin says so honestly instead of showing a dead upload button.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Cloud Console -> APIs & Services -> Credentials. Enable "Places API
# (New)" on the same project. Deliberately NOT prefixed NEXT_PUBLIC_ — every
# call goes through a Server Action (lib/actions/address-autocomplete.ts),
# so this key is never sent to the browser and can be restricted by server
# IP rather than HTTP referrer. Checkout's address autocomplete degrades
# silently to plain manual entry when this is unset — see
# CHECKOUT_PREMIUM_SPEC.md §2.
GOOGLE_PLACES_API_KEY=

# opendata.businessportal.gr/register/ — ΓΕΜΗ requires a registration +
# approval step, not instant self-serve (see CHECKOUT_PREMIUM_SPEC.md §4.3).
# Server-only, sent as the `api_key` header. Checkout's ΑΦΜ-triggered
# company-name lookup degrades silently to manual entry when unset.
GEMI_API_KEY=

# Required for the Meta/Facebook/Instagram product feed
# (/api/meta/product-feed) to serve anything but a 503 — a random value you
# choose (e.g. `openssl rand -hex 32`), pasted into the feed URL's `?token=`
# query param both here and in Meta Commerce Manager's "Data feed" setup.
# Not a real secret handshake, just a scrape deterrent for otherwise-public
# catalog data — rotate it any time by changing this value and re-pasting
# the new URL into Commerce Manager.
META_FEED_TOKEN=

# Optional, both together. Meta Conversions API (server-side event
# forwarding, deduplicated against the browser Pixel via a shared event_id —
# see lib/analytics/capi.ts). Generated in Meta Business Manager -> Events
# Manager -> your Pixel -> Settings -> Conversions API -> "Generate access
# token" (System User token) and the Dataset ID shown on that same screen.
# lib/analytics/capi.ts's sendServerEvent() logs CAPI_NOT_CONFIGURED and
# no-ops when either is unset — no call site in this codebase invokes it yet
# (prepared architecture, not a live integration; see that file's own
# comment for the intended wiring point once these are set).
META_CAPI_ACCESS_TOKEN=
META_DATASET_ID=

# ai.google.dev -> Get API key. Server-only — every call goes through
# lib/ai/gemini-provider.ts via a Server Action (lib/admin/ai-seo-actions.ts),
# so this key is never sent to the browser. The admin product editor's
# "✨ Δημιουργία SEO + GEO" button degrades to a clear "δεν έχει ρυθμιστεί"
# error (not a silent failure, not a crash) when this is unset — nothing
# else in the app depends on it, and it is never called automatically
# (only on that button/its per-field "Αναδημιουργία" clicks).
GEMINI_API_KEY=
# Optional — defaults to gemini-3.6-flash if unset.
GEMINI_MODEL=
