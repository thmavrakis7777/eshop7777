# Copy to .env.local and fill in.

# Supabase Postgres connection string (Session pooler recommended). Required —
# every catalog/cart/checkout/admin read and write goes through this.
DATABASE_URL=

# Optional. The site's own real public URL — backs canonical URLs, sitemap
# entries, JSON-LD, Open Graph tags, and the link inside password-reset
# emails (lib/site-config.ts, lib/email/send.ts). Vercel auto-provides
# VERCEL_URL for every deployment, but that's the deployment's own hash URL
# (e.g. project-xyz123.vercel.app), NOT a custom domain attached in the
# Vercel dashboard — so once a real domain is attached, set this explicitly
# to it (e.g. https://www.mavrakishome.gr) or canonical URLs and reset-
# password links will point at the wrong host. Required for a correct
# password-reset link in production if a custom domain is in use.
NEXT_PUBLIC_SITE_URL=

# SendGrid (transactional email — order confirmation, password reset). Both
# are required together; if either is unset, lib/email/send.ts logs
# EMAIL_CONFIG_MISSING and skips sending rather than blocking checkout or
# password reset — so the app runs fine without these in development, but
# production needs both for customers to actually receive email.
#
# SENDGRID_API_KEY: SendGrid dashboard -> Settings -> API Keys -> Create API
# Key. "Restricted Access" with only "Mail Send" permission is enough — this
# key is server-only (never sent to the browser) and calls SendGrid's REST
# API directly (no SDK). Never commit a real value here or anywhere else.
SENDGRID_API_KEY=

# SENDGRID_FROM_EMAIL: the "from" address customers see. Must be an address
# or domain verified in SendGrid -> Settings -> Sender Authentication (Single
# Sender Verification for one address, or full domain authentication for
# anything @your-domain) — SendGrid rejects sends from an unverified sender.
SENDGRID_FROM_EMAIL=

# Supabase project URL and service role key — public URL derivation
# (lib/storage/urls.ts) only needs NEXT_PUBLIC_SUPABASE_URL; image upload
# itself isn't built yet (blocked on these credentials), gated by
# isStorageConfigured() in lib/admin/cms.ts, which needs both. Until both are
# set, the admin says so honestly instead of showing a dead upload button.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Cloud Console -> APIs & Services -> Credentials. Enable "Places API
# (New)" on the same project. Deliberately NOT prefixed NEXT_PUBLIC_ — every
# call goes through a Server Action (lib/actions/address-autocomplete.ts),
# so this key is never sent to the browser and can be restricted by server
# IP rather than HTTP referrer. Checkout's address autocomplete degrades
# silently to plain manual entry when this is unset — see
# CHECKOUT_PREMIUM_SPEC.md §2.
GOOGLE_PLACES_API_KEY=

# opendata.businessportal.gr/register/ — ΓΕΜΗ requires a registration +
# approval step, not instant self-serve (see CHECKOUT_PREMIUM_SPEC.md §4.3).
# Server-only, sent as the `api_key` header. Checkout's ΑΦΜ-triggered
# company-name lookup degrades silently to manual entry when unset.
GEMI_API_KEY=
